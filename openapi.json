{
  "openapi": "3.1.0",
  "info": {
    "title": "Urja Meter Ops API Adapter",
    "version": "1.0.0",
    "description": "REST adapter for meter records, consumption readings, network hierarchy, and transformer information from the Urja Meter Ops portal."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Meters"
    },
    {
      "name": "Consumption"
    },
    {
      "name": "Network"
    },
    {
      "name": "Transformers"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check API process health",
        "responses": {
          "200": {
            "description": "API process is responding",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meters": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "List and filter meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search over meter ID and serial number.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "phaseType",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "make",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "installType",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "build",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "transformerCode",
            "in": "query",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated meter collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeterPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}": {
      "get": {
        "tags": [
          "Meters"
        ],
        "summary": "Get a meter by ID",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Meter found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Meter"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Meter not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "METER_NOT_FOUND",
                    "message": "Meter not found"
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/meters/{meterId}/consumption": {
      "get": {
        "tags": [
          "Consumption"
        ],
        "summary": "Get consumption readings for a meter",
        "parameters": [
          {
            "$ref": "#/components/parameters/MeterId"
          }
        ],
        "responses": {
          "200": {
            "description": "Consumption readings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "meterId",
                    "count",
                    "readings"
                  ],
                  "properties": {
                    "meterId": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "readings": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EnergyReading"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Meter is not present in the export snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "METER_NOT_FOUND",
                    "message": "Meter not found"
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/hierarchy": {
      "get": {
        "tags": [
          "Network"
        ],
        "summary": "Get the derived network hierarchy",
        "responses": {
          "200": {
            "description": "Hierarchy derived from the meter export snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "fetchedAt"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HierarchyNode"
                      }
                    },
                    "fetchedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/transformers": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "List derived transformer groups",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search over transformer code and names.",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated transformer collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransformerPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    },
    "/api/v1/transformers/{code}": {
      "get": {
        "tags": [
          "Transformers"
        ],
        "summary": "Get a transformer by code",
        "description": "Returns a transformer only when its code resolves to one network path.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,100}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unambiguous transformer found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "fetchedAt"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Transformer"
                    },
                    "fetchedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Transformer code not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "TRANSFORMER_NOT_FOUND",
                    "message": "Transformer not found"
                  }
                }
              }
            }
          },
          "409": {
            "description": "Transformer code matches multiple network paths",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "AMBIGUOUS_TRANSFORMER_CODE",
                    "message": "Transformer code matches multiple network paths"
                  }
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          },
          "504": {
            "$ref": "#/components/responses/UpstreamTimeout"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "MeterId": {
        "name": "meterId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Request parameters failed validation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "VALIDATION_ERROR",
                "message": "Invalid request parameters"
              }
            }
          }
        }
      },
      "UpstreamError": {
        "description": "Upstream portal or upstream data failure",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "UPSTREAM_ERROR",
                "message": "Upstream service unavailable"
              }
            }
          }
        }
      },
      "UpstreamTimeout": {
        "description": "The upstream portal request timed out",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": {
                "code": "UPSTREAM_TIMEOUT",
                "message": "Portal request timed out"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meter": {
        "type": "object",
        "required": [
          "meterId",
          "serialNumber",
          "make",
          "phaseType",
          "status",
          "installType",
          "build",
          "transformerCode",
          "hierarchy",
          "location",
          "dataQuality"
        ],
        "properties": {
          "meterId": {
            "type": "string"
          },
          "serialNumber": {
            "type": [
              "string",
              "null"
            ]
          },
          "make": {
            "type": [
              "string",
              "null"
            ]
          },
          "phaseType": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "installType": {
            "type": [
              "string",
              "null"
            ]
          },
          "build": {
            "type": [
              "string",
              "null"
            ]
          },
          "transformerCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "hierarchy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyLevel"
            },
            "minItems": 7,
            "maxItems": 7
          },
          "location": {
            "type": "object",
            "required": [
              "latitude",
              "longitude"
            ],
            "properties": {
              "latitude": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "dataQuality": {
            "type": "object",
            "required": [
              "issues"
            ],
            "properties": {
              "issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "HierarchyLevel": {
        "type": "object",
        "required": [
          "level",
          "code",
          "name"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "MeterPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "fetchedAt"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Meter"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EnergyReading": {
        "type": "object",
        "required": [
          "timestamp",
          "timestampRaw",
          "kwh",
          "kvah",
          "voltageR"
        ],
        "properties": {
          "timestamp": {
            "type": [
              "string",
              "null"
            ],
            "description": "Parsed date-time without timezone information."
          },
          "timestampRaw": {
            "type": [
              "string",
              "null"
            ]
          },
          "kwh": {
            "type": [
              "number",
              "null"
            ]
          },
          "kvah": {
            "type": [
              "number",
              "null"
            ]
          },
          "voltageR": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "HierarchyNode": {
        "type": "object",
        "required": [
          "level",
          "code",
          "name",
          "children"
        ],
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "zone",
              "circle",
              "division",
              "subdivision",
              "substation",
              "feeder",
              "dt"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "meterCount": {
            "type": "integer",
            "minimum": 1
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyNode"
            }
          }
        }
      },
      "Transformer": {
        "type": "object",
        "required": [
          "code",
          "names",
          "hierarchy",
          "meterCount"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hierarchy": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HierarchyLevel"
            }
          },
          "meterCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "TransformerPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "fetchedAt"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Transformer"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
